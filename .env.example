# Optional: cloud synchronisation via Supabase. Without these two values the
# cloud mode stays disabled and the app is offline-only.
# Both values are public (the anon key is meant for clients); they are baked
# into the frontend at build time.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
